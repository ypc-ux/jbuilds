# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# GitHub API
GITHUB_TOKEN=your_github_token_here
# Optional: Use this if you have API rate limit issues
# Leave empty to use public GitHub API (60 requests/hour)

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentgraphology
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentgraphology
DB_USER=postgres
DB_PASSWORD=password

# Evaluation Storage
EVALUATIONS_TABLE=evaluations
COMPARISONS_TABLE=comparisons

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://agentgraphology.com

# Session/Security
SESSION_SECRET=your_session_secret_here

# Optional: Sentry for error tracking
# SENTRY_DSN=https://...

# Optional: Custom scoring weights (leave empty for defaults)
# WEIGHT_PRODUCTIVITY=25
# WEIGHT_TECHNICAL_DEBT=25
# WEIGHT_BUSINESS_FIT=20
# WEIGHT_IMPLEMENTATION_EFFORT=20
# WEIGHT_COST_BENEFIT=10
